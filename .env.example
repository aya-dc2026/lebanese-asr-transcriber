# Copy this file to .env and fill in real values. Never commit .env itself.

# Path to the model you want the inference engine to load at startup.
# Start with the dialectal fine-tune if you have it, else the vanilla base model.
MODEL_PATH=models/base/qwen3-asr-0.6b-arabic-dialectal

# Path to the currently "promoted" LoRA adapter (created after your first retrain).
# Leave empty until Phase 4.
ADAPTER_PATH=

# bcrypt/argon2 hash of your retrain password - generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# Never store the plaintext password anywhere.
RETRAIN_PASSWORD_HASH=

# Where the SQLite correction store lives.
CORRECTIONS_DB_PATH=data/corrections.db

# Device for inference/training ("cuda" for your RTX 5090, "cpu" as a fallback).
DEVICE=cuda
